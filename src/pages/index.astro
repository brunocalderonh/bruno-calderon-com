---
import Layout from "../layouts/Layout.astro";
import Paper from "../components/Paper.astro";

const papers = [
  {
    year: "2026",
    venue: "Journal of Development Economics",
    title:
      "Beliefs, information sharing, and mental health care use among university students",
    authors:
      "Alisher Batmanov, Idaliya Grigoryeva, Bruno Calderón-Hernández, Roberto González-Téllez, Alejandro Guardiola Ramírez",
    url: "https://doi.org/10.1016/j.jdeveco.2025.103646",
    doi: "10.1016/j.jdeveco.2025.103646",
    note: "Volume 180, 103646",
  },
  {
    year: "2025",
    venue: "Scientific Data (Nature)",
    title: "Electoral precinct-level database for Mexican municipal elections",
    authors:
      "Bruno Calderón-Hernández, Horacio Larreguy, John Marshall, José Luis Pérez-Castellanos",
    url: "https://www.nature.com/articles/s41597-025-04918-9",
    doi: "10.1038/s41597-025-04918-9",
    note: "Volume 12, article 582",
  },
  {
    year: "2025",
    venue: "Pauvretés multiples (ISTE, book chapter)",
    title:
      "Impact des TIC, secteurs économiques et localisation géographique sur les salaires au Mexique",
    authors:
      "Cuauhtémoc Calderón Villarreal, Luis Huesca Reynoso, Bruno Calderón Hernández",
    url: "https://www.istegroup.com/fr/produit/pauvretes-multiples/",
    note: "Chapter 8 · ISBN 978-1-83612-049-0",
  },
];
---

<Layout title="Bruno Calderón Hernández">
  <main class="max-w-7xl mx-auto px-6 md:px-8 py-12 md:py-16">
    <!-- HERO: split layout — text in a left column (col-7), large portrait fully
         visible on the right (col-5), both vertically centered. -->
    <section class="mb-20 lg:grid lg:grid-cols-12 lg:gap-x-8 lg:items-center lg:min-h-[30rem]">
      <!-- Mobile-only portrait stacks above name -->
      <div class="lg:hidden flex justify-center mb-10">
        <img
          src="/headshot.jpg"
          alt="Bruno Calderón Hernández"
          width="288"
          height="360"
          class="w-64 sm:w-72 aspect-[4/5] rounded-3xl object-cover ring-1 ring-[var(--color-rule)] dark:ring-[var(--color-rule-dark)] shadow-sm"
        />
      </div>

      <article class="lg:col-span-7 max-w-2xl">
        <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl leading-[1.05] tracking-tight mb-5">
          Bruno Calderón Hernández
        </h1>
        <p class="text-lg md:text-xl text-[var(--color-ink-soft)] dark:text-[var(--color-ink-soft-dark)] leading-relaxed text-left hyphens-none md:text-justify md:hyphens-auto mb-6">
          Political Science PhD student at the University of Michigan,
          studying the political economy of development and electoral
          politics across Latin America and the developing world —
          quantitative methods and machine learning.
        </p>
        <div class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-lg">
          <a href="#about">About</a>
          <a href="#research">Research</a>
          <a href="/cv.pdf" target="_blank" rel="noopener">CV</a>
        </div>
      </article>

      <div class="hidden lg:flex lg:col-span-5 justify-end self-center">
        <img
          src="/headshot.jpg"
          alt="Bruno Calderón Hernández"
          width="480"
          height="600"
          class="w-full max-w-[19rem] xl:max-w-[22rem] 2xl:max-w-[26rem] aspect-[4/5] rounded-3xl object-cover ring-1 ring-[var(--color-rule)] dark:ring-[var(--color-rule-dark)] shadow-sm"
        />
      </div>
    </section>

    <!-- Body sections: same centered reading width as the hero's text column. -->
    <article class="max-w-2xl mx-auto">
      <section id="about" class="mb-16">
        <h2 class="font-serif text-2xl mb-5 tracking-tight">About</h2>
        <div class="space-y-4 text-[var(--color-ink)] dark:text-[var(--color-ink-dark)] leading-relaxed text-left hyphens-none md:text-justify md:hyphens-auto">
          <p>
            I'm a PhD student in Political Science at the University of
            Michigan. Substantively, I'm interested in the political economy
            of development in Latin America and across the developing world.
          </p>
          <p>
            Before this I did an M.A. in Applied Economics at ITAM, where I
            worked with Horacio Larreguy on the human-capital and demographic
            effects of NAFTA, and a B.A. in Economics at San Diego State. I
            also served as Deputy Director of Economic Affairs and Innovation
            at the UNDP–Mexican Ministry of Foreign Affairs.
          </p>
          <p>
            Most of my work starts with building a dataset and then using it.
            Recent projects include precinct-level returns for Mexican
            municipal elections from 1994 to 2019, former paramilitaries in
            democratic politics, an AI tool's effect on fact-checking output,
            and the demand for mental health services among university
            students. I use survey and field experiments,
            difference-in-differences, event studies, and regression
            discontinuity. I work in Spanish, English, and French.
          </p>
        </div>
      </section>

      <section id="research" class="mb-16">
        <h2 class="font-serif text-2xl mb-2 tracking-tight">Research</h2>
        <p class="text-sm text-[var(--color-ink-soft)] dark:text-[var(--color-ink-soft-dark)] mb-6">
          Selected publications and chapters.
        </p>
        <div>
          {papers.map((p) => <Paper {...p} />)}
        </div>
        <p class="mt-6 text-sm">
          <a
            href="https://scholar.google.com/citations?user=HFpnGykAAAAJ&hl=en"
            target="_blank"
            rel="noopener"
          >
            Full list on Google Scholar →
          </a>
        </p>
      </section>

      <footer
        class="mt-16 pt-8 border-t border-[var(--color-rule)] dark:border-[var(--color-rule-dark)] text-xs text-[var(--color-ink-soft)] dark:text-[var(--color-ink-soft-dark)] flex justify-between"
      >
        <span>© {new Date().getFullYear()} Bruno Calderón Hernández</span>
        <span>Built with Astro · Ann Arbor</span>
      </footer>
    </article>
  </main>
</Layout>
